# Supabase - required
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Canonical public origin used by the OAuth callback in production
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Admin OTP email - required in production when OTP is enabled
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=ExamHub <noreply@yourdomain.com>

# ---------------------------------------------------------------------------
# Chấm tự luận có AI (src/lib/essay-ai) - SERVER-ONLY
#
# TUYỆT ĐỐI không đặt tiền tố NEXT_PUBLIC_ cho bất kỳ biến nào dưới đây.
# Tiền tố đó khiến giá trị được nhúng vào bundle trình duyệt, nghĩa là công
# khai API key. Xem AGENTS.md mục 5.
#
# Trạng thái 2026-08-03: mới có lớp logic, chưa có worker/route/migration.
# Để trống toàn bộ nếu chưa triển khai; pipeline sẽ tự tắt.
# ---------------------------------------------------------------------------

# OCR ảnh bài làm bằng Gemini (mặc định). Đặt GEMINI_API_KEY là đủ.
#
# KHÔNG dùng NEXT_PUBLIC_GEMINI_API_KEY. Tiền tố NEXT_PUBLIC_ khiến Next.js
# nhúng giá trị vào bundle JavaScript gửi xuống trình duyệt — học sinh mở
# DevTools là đọc được key, dùng hết quota và tự gọi API chấm bài với rubric
# tuỳ ý. Biến dưới đây chỉ tồn tại trong tiến trình server.
GEMINI_API_KEY=

# Tuỳ chọn. Bỏ trống thì dùng gemini + gemini-3.6-flash.
# Model phải nằm trong allowlist tại src/lib/essay-ai/model-allowlist.ts
# Với họ gemini-3.x, adapter tự gửi thinkingConfig.thinkingLevel='minimal'
# (OCR là chép chữ, không cần suy luận); họ 2.x không hiểu tham số này nên
# không được gửi kèm.
OCR_PROVIDER=
OCR_API_KEY=
OCR_MODEL=

# Chấm theo rubric
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Kill-switch. Chỉ chuỗi 'true' mới bật; mọi giá trị khác đều là tắt.
# ESSAY_AI_ENABLED tắt toàn bộ pipeline.
# ESSAY_AI_AUTO_FINALIZE chỉ tắt phần AI tự chốt điểm, giữ lại OCR + gợi ý.
# Tách đôi để khi phát hiện chấm sai hàng loạt có thể ngắt việc công bố điểm
# mà không mất phần nhận dạng ảnh.
#
# ESSAY_AI_AUTO_FINALIZE bật từ 2026-08-06 (quyết định chủ dự án: đây là lớp
# học thêm, điểm không phải điểm học bạ, chấp nhận sửa tay khi AI chấm sai).
#
# Học sinh nộp bài xong được chấm NGAY qua POST /api/essay-ai/grade-mine (route
# gọi bằng session học sinh, phạm vi khoá vào attempt của chính họ). Cron
# grade-queue vẫn chạy làm lưới an toàn cho trường hợp đóng tab giữa chừng.
ESSAY_AI_ENABLED=true
ESSAY_AI_AUTO_FINALIZE=true

# Ngưỡng confidence tối thiểu (0..1) để AI được tự chốt điểm.
#
# ĐỂ TRỐNG LÀ MỘT CÁI BẪY: thiếu hoặc sai định dạng đều bị coi là 1.0, và 1.0
# nghĩa là gần như KHÔNG BAO GIỜ auto-chốt — DeepSeek trả confidence 0.95 vẫn bị
# chặn bằng trigger `low_grading_confidence`. Ngày 2026-08-07 đây chính là thứ
# làm auto-chốt không chạy dù mọi cờ khác đã bật đúng; nhìn từ ngoài nó giống hệt
# "AI không chấm được".
#
# Mặc định "an toàn = 1.0" là có chủ đích (cấu hình sai phải làm hệ thống thận
# trọng hơn), nhưng nếu bạn muốn auto-chốt chạy thì PHẢI đặt một số cụ thể.
# 0.8 là mức đang dùng: qua được bài rõ ràng, vẫn chặn bài model tự báo không chắc.
ESSAY_AI_CONFIDENCE_MIN=0.8

# Trần chi phí tháng, USD. 0 hoặc để trống nghĩa là chưa đặt trần.
# Chạm trần thì bài về hàng chờ giáo viên, không phải bị chấm 0 điểm.
ESSAY_AI_MONTHLY_COST_CAP=

# Kill-switch tự động theo mức giáo viên chấm đè (src/lib/essay-ai/override-guard.ts).
# Worker tính lại mỗi lượt: nếu giáo viên đang phải sửa điểm AI quá nhiều, hoặc
# chưa đủ bài đối chiếu để biết AI chấm đúng hay sai, thì auto-chốt bị chặn dù
# ESSAY_AI_AUTO_FINALIZE có bật. Trạng thái hiện ở /admin/essay-ai.
#
# Cả ba biến: để trống = dùng mặc định thận trọng bên dưới. Giá trị sai định dạng
# cũng về mặc định — cấu hình lỗi không được làm cổng nới ra.
#
# Số bài đã đối chiếu tối thiểu trước khi được phép auto-chốt. Mặc định 0.
#
# 0 = không đòi bằng chứng trước, bài ĐẦU TIÊN cũng được AI chốt điểm ngay. Chủ
# dự án chọn mức này ngày 2026-08-07: lớp học thêm, điểm không phải điểm học bạ,
# và yêu cầu là học sinh nộp xong thấy điểm luôn. Đánh đổi: bài đầu được chốt
# bằng niềm tin vào model, không bằng số liệu.
#
# Hai ngưỡng tỷ lệ bên dưới VẪN siết ngay từ bài đối chiếu đầu tiên, nên phanh tự
# động không mất. Thấy AI chấm lệch nhiều thì đặt lại số dương (ví dụ 20) là quay
# về chế độ đòi bằng chứng, không cần sửa code.
ESSAY_AI_OVERRIDE_MIN_COMPARED=0
# Tỷ lệ bài giáo viên phải đổi điểm, 0..1. Mặc định 0.3.
ESSAY_AI_OVERRIDE_MAX_CHANGED_RATE=
# Tỷ lệ bài lệch quá 20% thang điểm câu đó, 0..1. Mặc định 0.05.
# Con số này đo THIỆT HẠI, không đo độ chính xác trung bình, nên ngưỡng chặt hơn.
ESSAY_AI_OVERRIDE_MAX_SERIOUS_RATE=

# Số ngày giữ TỆP ảnh bài làm trên Storage. Mặc định 365.
#
# Chỉ tệp bị xoá; metadata (hash, kích thước, thời điểm) giữ vĩnh viễn, nên vẫn
# chứng minh được "bài này đã chấm trên ảnh có hash X". Job dọn:
#   POST /api/essay-ai/uploads-ttl   Authorization: Bearer <CRON_SECRET>
#
# Giá trị sai hoặc để trống KHÔNG làm TTL ngắn lại — nó về 365. Xoá tệp không
# hoàn lại được, nên một typo ở đây không được biến thành "xoá sớm hơn dự định".
ESSAY_UPLOAD_TTL_DAYS=

# Secret gọi worker chấm và job dọn ảnh:
#   POST /api/essay-ai/grade-queue    Authorization: Bearer <CRON_SECRET>
#   POST /api/essay-ai/uploads-ttl    Authorization: Bearer <CRON_SECRET>
#
# Hai endpoint này chạy bằng SUPABASE_SERVICE_KEY (bypass RLS), nên secret này
# tương đương quyền admin — sinh chuỗi ngẫu nhiên đủ dài, đừng đặt tay:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Để trống thì cả hai endpoint trả 503. Đó là chủ ý: thiếu cấu hình phải khoá
# endpoint, không phải mở nó.
CRON_SECRET=
